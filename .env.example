# Copy this file to `.env` at the solution root and fill in real values.
# `.env` is git-ignored and must never be committed.

DEEPSEEK_API_KEY=
GITHUB_TOKEN=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CONNECTION_STRING=Server=localhost,1433;Database=AgenticCommerceDB;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;

# Signing key for JWTs issued by AI-Ecommerce.Api. Must be a long, random,
# unpredictable string (32+ characters). Generate one, e.g.:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Never reuse the same secret across environments, and rotate it if it ever leaks.
JWT_SECRET=
